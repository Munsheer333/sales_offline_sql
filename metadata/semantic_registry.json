          "expression": "ROUND(SUM(netweight_tmt)::numeric, 2)",
          "alias": "actual_sales_tmt",
          "unit_default": "TMT",
          "unit_mt_expression": "ROUND(SUM(netweight_tmt * 1000)::numeric, 2)"
        },
        "mom_level": {
          "column": "netweight_tmt",
          "aggregation": "SUM",
          "expression": "ROUND(SUM(netweight_tmt)::numeric, 2)",
