    "market_share": {
      "description": "Percentage of total market sales captured by a company",
      "aliases": ["market share", "share", "market contribution", "share of market"],
      "mappings": {
        "industry_performance": {
          "expression": "ROUND((SUM(CASE WHEN comname = '<COMPANY>' THEN netweight_tmt ELSE 0 END) * 100.0) / NULLIF(SUM(netweight_tmt), 0), 2)",
          "alias": "market_share_percentage",
          "requires_groupby": ["comname"],
          "type": "ratio"
        }
      }
    },

    "growth": {
      "description": "Year-over-year or month-over-month percentage change in sales",
      "aliases": ["growth", "growth rate", "yoy growth", "year on year", "year-on-year", "yoy", "change", "increase", "decline", "mom growth", "month over month"],
      "mappings": {
        "industry_performance": {
          "expression": "ROUND(((current_sales - previous_sales) * 100.0) / NULLIF(previous_sales, 0), 2)",
          "alias": "growth_percentage",
          "type": "computed",
          "requires_two_periods": true
        }
      }
    },

