# Database Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myoffice_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Offline & LLM Configuration
OFFLINE_MODE=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5-coder:1.5b
FAST_LLM_MODEL=qwen2.5-coder:1.5b
FAST_LLM_TIMEOUT_SECONDS=15
LLM_GENERATION_TIMEOUT_SECONDS=30
LLM_REPAIR_TIMEOUT_SECONDS=15
PIPELINE_TIMEOUT_SECONDS=45

# Embeddings Configuration
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIM=768
EMBED_LOCAL_FILES_ONLY=true
EMBED_MODEL_PATH=
CURRENT_FINANCIAL_YEAR=2025-2026

# Seed & Retrieval Settings
SEED_PAIRS_PATH=seed_pairs.json
TOP_K=5
